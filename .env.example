# ==========================================
# 🍼 童童生活记录与小爱音箱 AI 助手 环境变量配置
# ==========================================

# 1. 小米智能音箱账户配置
SPEAKER_DID=Xiaomi 智能音箱 Pro
XIAOMI_USER_ID=123456789
XIAOMI_PASSWORD=your_xiaomi_password
XIAOMI_PASS_TOKEN=

# 2. HermesAgent 与 Python 执行路径
HERMES_PYTHON=/Users/your_username/.hermes/hermes-agent/venv/bin/python
HERMES_CHAT_RUNNER=/Users/your_username/.hermes/scripts/run_baby_hermes_chat.py

# 3. Cloudflare Fixed Named Tunnel 配置 (选填)
# 如果留空则自动启动 Quick Tunnel 随机临时域名
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# 4. Telegram 告警 Bot 配置 (通过 hermes send 发送)
TELEGRAM_ALERT_TARGET=telegram
